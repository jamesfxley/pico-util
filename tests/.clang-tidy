# Library-owned test-tree overrides layered on the root .clang-tidy.
#
# Each rule below is a standing deviation registered in the library's
# docs/deviations.md, with one row for each directory where this file takes
# effect. The name must be the canonical check and not an alias. The root config
# disables aliases in favour of their canonical spelling, so an alias here would
# suppress nothing while appearing to.
InheritParentConfig: true

Checks: >
  -readability-magic-numbers

# Literal sizes, offsets, counts and timestamps in a test are the case under
# test and are not shared with production code. Hoisting each to a named
# constant would move the expected value away from the assertion that reads it.
